# =============================================================================
# AI Million-Dollar Fundraising Experiment — env template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# --- Phase 1+2 (current) ---
# Required to call OpenAI Writer AI and Safety AI.
OPENAI_API_KEY=

# When "true", the cron orchestrator generates + saves attempts but never
# calls the X API. Phase 1+2 always runs in dry-run mode.
DRY_RUN=true

# --- Phase 3 (Supabase) ---
# Create a Supabase project, copy these from Project Settings → API.
# SERVICE_ROLE_KEY must stay server-only.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4 (Vercel cron protection) ---
# Random long string. Used in the Authorization header by Vercel Cron.
# CRON_SECRET=

# --- Phase 5 (X / Twitter API) ---
# X_APP_KEY=
# X_APP_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# --- Phase 6 (Stripe) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
