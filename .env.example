# =============================================================================
# AI Million-Dollar Fundraising Experiment — env template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# --- Phase 1+2 (current) ---
# Required to call OpenAI Writer AI and Safety AI.
OPENAI_API_KEY=
# Optional. Daily Strategy AI defaults to gpt-5.5-pro; change if your account uses
# a different model alias.
STRATEGY_MODEL=gpt-5.5-pro
# If the primary Strategy model is rate-limited or quota-exhausted, fallback here.
STRATEGY_FALLBACK_MODEL=gpt-5.5

# When "true", the cron orchestrator generates + saves attempts but never
# calls the X API. Phase 1+2 always runs in dry-run mode.
DRY_RUN=true

# --- Phase 3 (Supabase) ---
# Create a Supabase project, copy these from Project Settings → API.
# SERVICE_ROLE_KEY must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4 (cron protection) ---
# Long random string. Hit /api/cron/hourly with `Authorization: Bearer ${CRON_SECRET}`.
# Generate with: openssl rand -hex 32  (or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# Same value must also be set in Vercel env vars AND as a GitHub Actions repo secret.
CRON_SECRET=

# Minimum minutes between single-post generations. Prevents accidental rapid
# test-generate/cron calls from burning OpenAI credits and flooding attempts.
GENERATION_MIN_INTERVAL_MINUTES=60

# --- Phase 5 (X / Twitter API) ---
# Public profile URL shown on the homepage, e.g. https://x.com/your_handle
NEXT_PUBLIC_X_PROFILE_URL=

# OAuth 1.0a user context (the four pairs below). DO NOT use the Bearer
# Token here — it's read-only and cannot POST tweets. Get these from
# developer.x.com -> your app -> Keys and tokens.
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Phase 6 (Stripe) ---
# Get from https://dashboard.stripe.com/apikeys (use sk_live_* once live)
STRIPE_SECRET_KEY=
# Set after creating the webhook endpoint:
# Stripe Dashboard -> Developers -> Webhooks -> +Add endpoint
#   URL: https://<your-vercel>.vercel.app/api/stripe/webhook
#   Events: checkout.session.completed
# Then copy the "Signing secret" (starts with whsec_) below.
STRIPE_WEBHOOK_SECRET=
